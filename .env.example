# Admin login (local mode) — STRONG password rakho, kisi ko mat batao
# Vercel > Settings > Environment Variables me set karo
VITE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret admin URL path — /admin public nahi hai, sirf ye path khulega
# Example: VITE_ADMIN_PATH=rl-manager-2026 → site.com/rl-manager-2026
VITE_ADMIN_PATH=rl-manager-2026

# Optional cloud (Supabase) — jab multi-device sync chahiye tab
# VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Razorpay (online payment) — Dashboard > Settings > API Keys se Key ID
# Test key (rzp_test_...) turant kaam karti hai, KYC nahi chahiye
# Live key (rzp_live_...) ke liye account activation + KYC compulsory hai
# Key milte hi Vercel env me add karke redeploy karo — checkout auto-live
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxx

# AI Assistant (LLM) — bina key ke demo mode chalega (catalog-based)
# Live LLM chahiye to OpenAI-compatible endpoint dalo:
# VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
# VITE_AI_API_KEY=sk-xxxx
